{
  "name": "stylehub",
  "version": "1.0.0",
  "private": true,
  "description": "Fashion storefront with MongoDB, JWT authentication, and Razorpay checkout.",
  "main": "server.js",
  "scripts": {
    "start": "npm run start:backend",
    "start:backend": "node server.js",
    "start:frontend": "vite --host 0.0.0.0",
    "seed": "node seed.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "check": "node --check server.js && node --check seed.js && node --check app.js && node --check vite.config.mjs",
    "test": "npm run check && node --test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
